# Copy to .env.local and fill in. Never commit real values.
# Validated in src/env.ts.

# Public (may reach the browser)
# The site's public URL. If unset, Vercel's system URL variables are used at build time.
NEXT_PUBLIC_SITE_URL=

# Search engines: "true" allows indexing. Unset or "false" keeps the site noindex,
# robots.txt disallows everything and the sitemap is empty.
SITE_INDEXABLE=

# Contact pipeline (Phase 4)
DATABASE_URL=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=
IP_HASH_SALT=

# Optional: Ask assistant (Phase 5)
LLM_PROVIDER=
LLM_MODEL=
LLM_API_KEY=
ASK_DAILY_TOKEN_CAP=

# Optional: admin inbox (Phase 6)
ADMIN_PASSWORD_HASH=
JWT_SECRET=

# Optional: spam guard
TURNSTILE_SECRET_KEY=
